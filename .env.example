# Copy to .env (git-ignored) and fill in. Only the first block is required.

# Actual Budget server and file (Settings → Show advanced settings → Sync ID)
ACTUAL_SERVER_URL=http://actual:5006
ACTUAL_PASSWORD=
ACTUAL_SYNC_ID=
# Bearer token clients must send to the HTTP API (e.g. `openssl rand -hex 32`)
CURATOR_TOKEN=
# Classifier: openrouter-jev (default) | anthropic | openai-compatible
CLASSIFIER_PROVIDER=openrouter-jev
OPENROUTER_API_KEY=

# --- optional ---
# OPENROUTER_MODEL=typesafe/jev-1.14
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# OPENAI_BASE_URL=http://ollama:11434/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=
# Currency code shown to the classifier next to amounts, e.g. ILS, EUR
# CURRENCY=
# DATA_DIR=/data
# PORT=5007
# VOCAB_PATH=/data/curator.yaml
# CONFIDENCE_THRESHOLD=0.95
# TAG_THRESHOLD=0.7
# PROMOTE_AFTER=3
# RUN_INTERVAL_MINUTES=15
# LOOKBACK_DAYS=60
# Log decisions without writing anything to Actual
# DRY_RUN=true
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# NOTIFY_HA_PERSISTENT=false
